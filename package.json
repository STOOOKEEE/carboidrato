{
  "name": "xrpl-bari",
  "version": "0.1.0",
  "description": "Invoice financing on the XRP Ledger: tokenized invoices that carry a Groth16 zero-knowledge proof, funded by a Single Asset Vault through the Lending Protocol.",
  "keywords": [
    "xrpl",
    "tokenization",
    "real-world-assets",
    "zero-knowledge",
    "groth16",
    "invoice-financing",
    "mpt",
    "vault",
    "lending"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "tsx src/demo/main.ts",
    "demo:default": "tsx src/demo/main.ts --default",
    "demo:fund": "tsx src/demo/fund.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p web/e2e",
    "zk:install-circom": "cargo install --locked --git https://github.com/iden3/circom.git --tag v2.2.2 --root circuits/.tools circom",
    "zk:setup": "bash circuits/scripts/setup.sh",
    "zk:test": "node --import tsx --test src/zk/*.test.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "audit": "tsx src/audit/main.ts",
    "api": "npm run api:fund",
    "api:fund": "tsx src/api/fund/server.ts",
    "api:smoke": "tsx src/api/fund/smoke/main.ts",
    "samples": "tsx src/demo/sampleInvoices.ts",
    "fixtures": "tsx src/demo/fixtures.ts",
    "web": "vite web",
    "web:build": "vite build web",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@noble/hashes": "2.4.0",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "fastify": "5.12.8",
    "poseidon-lite": "0.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ripple-address-codec": "5.0.1",
    "snarkjs": "0.7.6",
    "xrpl": "5.4.0-beta.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/snarkjs": "0.7.9",
    "@vitejs/plugin-react": "6.3.0",
    "@xrpl-commons/xrpl": "4.6.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
